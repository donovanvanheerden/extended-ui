{
  "[lua]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "sumneko.lua"
  },
  "Lua.format.defaultConfig": {
    "indent_style": "space",
    "indent_width": 4,
    "continuation_indent": 4,
    "spaces_inside_table_brackets": false,
    "spaces_before_call": false,
    "space_before_function_open_paren": false,
    "keep_simple_function_one_line": true
  },
  "Lua.runtime.version": "Lua 5.1",
  "Lua.runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "Lua.workspace.library": [
